# ==============================================================================
# IDCI Platform - Local Environment Variables (.env.example)
# Copiar este archivo a deploy/local/.env para desarrollo local
# ==============================================================================

# PostgreSQL Warehouse
POSTGRES_USER=idci_admin
POSTGRES_PASSWORD=secure_password_2026
POSTGRES_DB=idci_analytics
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5435

# RustFS S3-compatible Object Storage
S3_ENDPOINT_URL=http://rustfs:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin2026
S3_BUCKET=opportunity-intelligence
S3_HOST_PORT_API=9002
S3_HOST_PORT_CONSOLE=9003

# Apache Airflow
AIRFLOW_HOST_PORT=8082
AIRFLOW_UID=50000

# OpenMetadata
OPENMETADATA_HOST=http://openmetadata:8585/api
OPENMETADATA_JWT_TOKEN=
