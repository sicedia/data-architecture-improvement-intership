# Copy to infra/.env (make infra-env does it). Local development values only.
# Versions follow Contex.md; see docs/cedia-alignment.md for the differences with CEDIA production.
POSTGRES_VERSION=16
POSTGRES_DB=scrapagents
POSTGRES_USER=scrapagents
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5433  # 5433 so it does not clash with a local PostgreSQL on 5432

RUSTFS_VERSION=1.0.4
RUSTFS_ACCESS_KEY=scrapagents
RUSTFS_SECRET_KEY=change-me-local-only
RUSTFS_S3_PORT=9000
RUSTFS_CONSOLE_PORT=9001

TIKA_VERSION=4.1.0
TIKA_PORT=9998

RUNTIME_PORT=8088

AIRFLOW_VERSION=3.4.0   # latest stable on 2026-11-09 (PyPI and Docker Hub)
AIRFLOW_PYTHON=3.12   # validated with dbt-core 1.12.3
AIRFLOW_PORT=8080
AIRFLOW_DB_PASSWORD=change-me-local-only
AIRFLOW_FERNET_KEY=36B3Ligp58zI_waeeuplaDjkQ79rJ9SlHeB9cRMH-ug=
AIRFLOW_JWT_SECRET=change-me-local-only-jwt-secret-0123456789
AIRFLOW_API_SECRET_KEY=change-me-local-only
PLATFORM_TIMEZONE=America/Guayaquil

DBT_CORE_VERSION=1.12.3   # keep in sync with dbt/requirements.txt (CEDIA pin)

# Obscura (headless browser in Rust, invariant 3). Playwright connects to it over CDP.
# Container: `--profile browser` of infra/ingestion (service `obscura`), token taken from the shell.
# Image h4ckf0r0day/obscura:0.2.6 (the tag has no "v"); it needs a token of at least 32 bytes:
#   export OBSCURA_CDP_TOKEN="$(openssl rand -hex 32)"
#   docker run -d --name obscura -p 127.0.0.1:9222:9222 -e OBSCURA_CDP_TOKEN h4ckf0r0day/obscura:0.2.6
# OBSCURA_CDP_URL=http://127.0.0.1:9222
# OBSCURA_CDP_TOKEN=   # secret: keep it in the shell or the secret manager, not in a committed file
# OBSCURA_USER_AGENT=
# OBSCURA_REQUIRED=0   # local development only
